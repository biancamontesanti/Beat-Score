{
  "compilerOptions": {
    "outDir": "bin",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "target": "ES2020",
    "lib": ["es2020"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "jsx": "react",
    "jsxFactory": "ReactEcs.createElement",
    "jsxFragmentFactory": "ReactEcs.Fragment"
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
